# ============================================================
# tt-copy 配置文件
# 使用方法：cp .env.example .env，然后填写下方参数
# ============================================================

# === AI 识图 & 文案生成（必填）===
KIMI_API_URL=https://api.kimi.com/coding/v1/messages
KIMI_API_KEY=sk-kimi-在这里填入你的Key

# === 项目安装路径（install.sh 自动填写，无需手动修改）===
TTCOPY_DIR=

# === 小红书多账号（可选）===
# 留空 = 默认账号（xhs_cookies.json）
# 填账号名 = 多账号隔离（首次使用会弹窗扫码，自动保存）
XHS_ACCOUNT=

# === 飞书自动流水线（默认关闭）===
# 取消下面这行的注释来启用飞书进度通知
# LARK_NOTIFY=true
